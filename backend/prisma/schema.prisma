generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum AccountType {
  SAVINGS
  CURRENT
  OD_CC
  SALARY
  JOINT
  NRE
  NRO
  CREDIT_CARD
  WALLET
  OTHER
}

enum EntityType {
  PERSON
  BUSINESS
  GOVERNMENT
  BANK
  UNKNOWN
}

enum IdentifierType {
  UPI
  ACCOUNT_NUMBER
  IFSC
  PHONE
  EMAIL
  NAME_FRAGMENT
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}
enum TransactionDirection {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  REVERSED
}

enum SourceType {
  MANUAL
  BANK_STATEMENT
  UPI
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts         Account[]
  entities         Entity[]
  financialEvents  FinancialEvent[]
  matchDecisions   EntityMatchDecision[]
  statementImports StatementImport[]
}

model Account {
  id            String      @id @default(cuid())
  userId        String
  name          String
  bankName      String?
  accountLast4  String?
  accountType   AccountType @default(SAVINGS)
  ifsc          String?
  branch        String?
  currency      String      @default("INR")
  nickname      String?
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRecords   TransactionRecord[]
  statementImports StatementImport[]

  @@index([userId])
}

model Entity {
  id        String     @id @default(cuid())
  userId    String
  name      String
  type      EntityType @default(UNKNOWN)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  aliases         EntityAlias[]
  identifiers     EntityIdentifier[]
  financialEvents FinancialEvent[]
  matchDecisions  EntityMatchDecision[]

  @@index([userId])
  @@index([userId, type])
}

model EntityAlias {
  id        String   @id @default(cuid())
  entityId  String
  alias     String
  createdAt DateTime @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
}

model FinancialEvent {
  id          String   @id @default(cuid())
  userId      String
  entityId    String?
  amount      Decimal  @db.Decimal(18, 2)
  direction   TransactionDirection
  status      TransactionStatus
  occurredAt  DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity        Entity?             @relation(fields: [entityId], references: [id], onDelete: SetNull)
  sourceRecords TransactionRecord[]

  @@index([userId, occurredAt])
  @@index([entityId, occurredAt])
}

model TransactionRecord {
  id               String     @id @default(cuid())
  financialEventId String
  accountId        String?
  sourceType       SourceType
  sourceReference  String?
  rawRowHash       String?
  rawDescription   String?
  amount           Decimal    @db.Decimal(18, 2)
  direction        TransactionDirection
  status           TransactionStatus
  occurredAt       DateTime
  createdAt        DateTime   @default(now())

  financialEvent FinancialEvent @relation(fields: [financialEventId], references: [id], onDelete: Cascade)
  account        Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([accountId, sourceReference])
  @@unique([accountId, rawRowHash])
  @@index([financialEventId])
  @@index([accountId, occurredAt])
  @@index([sourceReference])
}
enum MatchDecision {
  SAME
  NOT_SAME
  REVIEW
}
model EntityIdentifier {
  id        String         @id @default(cuid())
  entityId  String
  type      IdentifierType
  value     String
  rawValue  String
  createdAt DateTime       @default(now())

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, type, value])
  @@index([type, value])
  @@index([entityId])
}
model StatementImport {
  id            String       @id @default(cuid())
  userId        String
  accountId     String?
  sourceType    SourceType
  fileName      String?
  fileHash      String
  parsedCount   Int          @default(0)
  importedCount Int          @default(0)
  skippedCount  Int          @default(0)
  flaggedCount  Int          @default(0)
  status        ImportStatus @default(PENDING)
  startedAt     DateTime     @default(now())
  completedAt   DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([userId, fileHash])
  @@index([userId, startedAt])
  @@index([accountId, startedAt])
}

model EntityMatchDecision {
  id        String        @id @default(cuid())
  userId    String
  entityId  String
  alias     String
  decision  MatchDecision
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId, alias])
  @@index([userId, alias])
  @@index([userId, decision])
  @@index([entityId])
}